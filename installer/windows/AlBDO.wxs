<?xml version="1.0" encoding="UTF-8"?>
<!--
  AlBDO per-user MSI.

  Built by .github/workflows/release.yml:

    wix build AlBDO.wxs -d Version=1.2.3 -d BinaryPath=path\to\albedo.exe -o AlBDO-1.2.3-x64.msi

  The UpgradeCode identifies this product to Windows for good: every release
  must keep it, or installs stop upgrading in place and pile up side by side.
  The component GUIDs are likewise fixed for the life of their component.

  albedo is a command-line tool, so the installer puts it on the user's PATH
  and adds nothing to the Start menu: a shortcut to a CLI opens a console that
  prints help and closes.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
    <Package
        Name="AlBDO"
        Version="$(var.Version)"
        Manufacturer="AlBDO"
        UpgradeCode="C2AE65EB-F8E4-4F63-90FF-F3C14A20ADF5"
        Scope="perUser"
        InstallerVersion="500">

        <MajorUpgrade
            Schedule="afterInstallInitialize"
            DowngradeErrorMessage="A newer version of AlBDO is already installed." />

        <!--
          Pre-1.0 preview builds were published under a placeholder
          UpgradeCode, always as version 0.1.0, and installed albedo.exe to the
          same path. Left in place, uninstalling one would delete the other's
          binary. Remove exactly that product: the range is pinned to 0.1.0
          because the placeholder is a GUID other software may have copied too.
        -->
        <Upgrade Id="A1B2C3D4-E5F6-7890-ABCD-EF1234567890">
            <UpgradeVersion
                Property="ALBEDO_PREVIEW_FOUND"
                Minimum="0.1.0"
                Maximum="0.1.0"
                IncludeMinimum="yes"
                IncludeMaximum="yes"
                OnlyDetect="no" />
        </Upgrade>

        <MediaTemplate EmbedCab="yes" />

        <StandardDirectory Id="LocalAppDataFolder">
            <Directory Id="AlBDO.Root" Name="AlBDO">
                <Directory Id="INSTALLDIR" Name="bin">
                    <!--
                      A per-user component in the user profile keys on an HKCU
                      value, not on its file (ICE38), and removes the folders
                      it created (ICE64).
                    -->
                    <Component Id="AlbedoBinary" Guid="4B0761D4-B0C3-402E-A039-33701878C941">
                        <File
                            Id="AlbedoExe"
                            Source="$(var.BinaryPath)"
                            Name="albedo.exe"
                            Compressed="yes" />
                        <Environment
                            Id="PATH"
                            Name="PATH"
                            Value="[INSTALLDIR]"
                            Permanent="no"
                            Part="last"
                            Action="set"
                            System="no" />
                        <RegistryValue
                            Root="HKCU"
                            Key="Software\AlBDO"
                            Name="InstallDir"
                            Type="string"
                            Value="[INSTALLDIR]"
                            KeyPath="yes" />
                        <RemoveFolder Id="RemoveInstallDir" On="uninstall" />
                        <RemoveFolder Id="RemoveRootDir" Directory="AlBDO.Root" On="uninstall" />
                    </Component>
                </Directory>
            </Directory>
        </StandardDirectory>

        <Property Id="ARPHELPLINK" Value="https://github.com/Sen-Bishal/AlB-DO" />
        <Property Id="ARPURLINFOABOUT" Value="https://github.com/Sen-Bishal/AlB-DO" />

        <Feature Id="ProductFeature" Title="AlBDO CLI" Level="1">
            <ComponentRef Id="AlbedoBinary" />
        </Feature>

    </Package>
</Wix>
